# Agentic Multimodal Research Platform - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application
# =============================================================================
APP_NAME=Agentic Multimodal Research Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Secret key for JWT tokens (generate with: openssl rand -base64 32)
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# Database
# =============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://research:research@localhost:5432/research
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# Vector Store (ChromaDB)
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8000

# =============================================================================
# Redis (for task queue and caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Model Providers
# =============================================================================

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini API (official)
# GEMINI_API_KEY=AIzaSy...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# OpenAI-compatible providers (optional)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Default models (must be available in Ollama / Gemini)
DEFAULT_LLM_MODEL=llama3.1
DEFAULT_VISION_MODEL=llava
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
DEFAULT_RERANKER_MODEL=bge-reranker-base

# =============================================================================
# Search API (optional - for web search)
# =============================================================================
# SEARCH_API_URL=https://api.search-provider.com
# SEARCH_API_KEY=your-search-api-key

# =============================================================================
# File Upload
# =============================================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or console

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60